---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
}

const { title, description, image, type, publishedTime, noindex } = Astro.props;
---

<Base {title} {description} {image} {type} {publishedTime} {noindex}>
  <a href="#main" class="skip-link">Skip to content</a>
  <Nav />
  <main id="main" class="page-main" tabindex="-1">
    <slot />
  </main>
  <Footer />
</Base>

<style>
  .page-main {
    flex: 1;
    padding: var(--space-12) 0 var(--space-16);
    outline: none;
  }
</style>
