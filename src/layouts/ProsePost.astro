---
import Page from './Page.astro';

interface Props {
  title: string;
  date: Date;
  summary: string;
  readingTime: string;
  author?: string;
  tags?: string[];
}

const { title, date, summary, readingTime, author, tags } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Page title={title} description={summary}>
  <div class="container">
    <header class="post-header">
      <div class="post-header__meta">
        <a href="/book-memos" class="eyebrow back-link">← Book Memos</a>
      </div>
      <h1 class="post-title">{title}</h1>
      {author && <p class="post-author">{author}</p>}
      <div class="post-byline">
        <span class="eyebrow eyebrow--subtle">{formattedDate}</span>
        <span class="eyebrow eyebrow--subtle separator" aria-hidden="true">·</span>
        <span class="eyebrow eyebrow--subtle">{readingTime}</span>
        {tags && tags.map(tag => (
          <>
            <span class="eyebrow eyebrow--subtle separator" aria-hidden="true">·</span>
            <span class="eyebrow eyebrow--subtle">{tag}</span>
          </>
        ))}
      </div>
      <p class="post-summary">{summary}</p>
    </header>

    <div class="post-divider"></div>

    <div class="prose">
      <slot />
    </div>
  </div>
</Page>

<style>
  .post-header {
    padding-bottom: var(--space-8);
  }

  .post-header__meta {
    margin-bottom: var(--space-6);
  }

  .back-link {
    text-decoration: none;
    font-size: var(--size-xs);
  }
  .back-link:hover { text-decoration: underline; }

  .post-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: var(--size-3xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    max-width: 20ch;
    margin-bottom: var(--space-3);
  }

  .post-author {
    font-family: var(--font-mono);
    font-size: var(--size-sm);
    color: var(--color-subtle);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
  }

  .post-byline {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .separator { opacity: 0.4; }

  .post-summary {
    font-family: var(--font-prose);
    font-size: var(--size-md);
    line-height: var(--leading-normal);
    color: var(--color-subtle);
    max-width: 58ch;
    font-style: italic;
  }

  .post-divider {
    height: 1px;
    background: var(--color-border);
    margin: var(--space-8) 0;
  }
</style>
