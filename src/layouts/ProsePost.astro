---
import Page from './Page.astro';
import { formatDate, isoDate, tagHref, tagLabel } from '../lib/posts';

interface Props {
  title: string;
  date: Date;
  summary: string;
  readingTime: string;
  author?: string;
  tags?: string[];
  draft?: boolean;
}

const { title, date, summary, readingTime, author, tags = [], draft = false } = Astro.props;
---

<Page title={title} description={summary} type="article" publishedTime={date}>
  <article class="container container--post">
    <header class="post-header">
      <span class="stamp eyebrow">Book Memo</span>
      <h1 class="post-title">{title}</h1>
      <p class="post-subtitle">{summary}</p>
      <div class="post-meta">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime}</span>
        {author && (
          <>
            <span aria-hidden="true">·</span>
            <span class="post-meta__author">{author}</span>
          </>
        )}
        {tags.map((tag) => (
          <>
            <span aria-hidden="true">·</span>
            <a class="post-meta__tag" href={tagHref(tag)}>{tagLabel(tag)}</a>
          </>
        ))}
        {draft && <span class="draft-badge">Draft · dev only</span>}
      </div>
    </header>

    <hr class="rule post-rule" />

    <div class="prose">
      <slot />
    </div>
  </article>
</Page>
