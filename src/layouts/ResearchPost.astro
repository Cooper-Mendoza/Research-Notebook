---
import Page from './Page.astro';
import StatRow from '../components/StatRow.astro';
import { formatDate, isoDate, shortReadingTime, tagHref, tagLabel } from '../lib/posts';

interface Stat {
  label: string;
  value: string;
  note?: string;
}

interface Props {
  title: string;
  date: Date;
  summary: string;
  readingTime: string;
  /** Stamp above the title: "Research" or "Project". */
  kind?: string;
  /** Shown in the metadata row for project posts, e.g. "Dell". */
  client?: string;
  stats?: Stat[];
  tags?: string[];
  draft?: boolean;
}

const {
  title, date, summary, readingTime, kind = 'Research', client,
  stats = [], tags = [], draft = false,
} = Astro.props;
---

<Page title={title} description={summary} type="article" publishedTime={date}>
  <article class="container container--wide">
    <header class="post-header">
      <span class="stamp eyebrow">{kind}</span>
      <h1 class="post-title">{title}</h1>
      <p class="post-subtitle">{summary}</p>
      <div class="post-meta">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime}</span>
        {client && (
          <>
            <span aria-hidden="true">·</span>
            <span class="post-meta__author">for {client}</span>
          </>
        )}
        {tags.map((tag) => (
          <>
            <span aria-hidden="true">·</span>
            <a class="post-meta__tag" href={tagHref(tag)}>{tagLabel(tag)}</a>
          </>
        ))}
        {draft && <span class="draft-badge">Draft · dev only</span>}
      </div>
    </header>

    <hr class="rule post-rule" />

    {stats.length > 0 && <StatRow stats={stats} />}

    <div class="prose prose--research">
      <slot />
    </div>
  </article>
</Page>
