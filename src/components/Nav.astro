---
// The header tile is the generated favicon itself, so the two always match exactly.
import monogramSvg from '../../public/favicon.svg?raw';

const links = [
  { href: '/',            label: 'Home' },
  { href: '/research/',   label: 'Research' },
  { href: '/book-memos/', label: 'Book Memos' },
  { href: '/about/',      label: 'About' },
];

const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

/** 'page' = this exact page, 'section' = an ancestor section (e.g. Research while reading a research post). */
function state(href: string): 'page' | 'section' | undefined {
  if (pathname === href) return 'page';
  if (href !== '/' && pathname.startsWith(href)) return 'section';
  return undefined;
}

const monogram = monogramSvg.replace(
  '<svg ',
  '<svg class="monogram" width="28" height="28" aria-hidden="true" focusable="false" ',
);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="wordmark" aria-label="Cooper Mendoza — home">
      <Fragment set:html={monogram} />
      <span class="wordmark__text">Cooper Mendoza</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav-list">
        {links.map(({ href, label }) => {
          const s = state(href);
          return (
            <li>
              <a
                href={href}
                class:list={['nav-link', { 'nav-link--active': !!s }]}
                aria-current={s === 'page' ? 'page' : s === 'section' ? 'true' : undefined}
              >
                {label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: var(--space-2) 0;
    text-decoration: none;
    color: var(--color-text);
    flex-shrink: 0;
  }

  .wordmark :global(.monogram) {
    display: block;
    flex-shrink: 0;
  }

  .wordmark__text {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: var(--size-md);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 var(--space-4);
  }

  /* Padded so each link is a comfortable ~32px-tall tap target on phones. */
  .nav-link {
    display: inline-block;
    padding: var(--space-2) var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    line-height: 1.5;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-subtle);
    text-decoration: none;
    transition: color 0.15s;
  }

  .nav-link:hover { color: var(--color-text); }

  .nav-link--active { color: var(--color-accent-text); }

  /* Small screens: the tile alone is the logo. */
  @media (max-width: 480px) {
    .wordmark__text { display: none; }
    .nav-list { gap: 0 var(--space-3); }
  }
</style>
