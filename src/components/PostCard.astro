---
import { formatDate, isoDate, shortReadingTime, KIND_LABEL, type PostType } from '../lib/posts';

interface Props {
  title: string;
  date: Date;
  summary: string;
  readingTime: string;
  href: string;
  type: PostType;
  author?: string;
  draft?: boolean;
  /** 'home': kind + date on top (homepage). 'list': metadata in a right-hand column (section pages, archive). */
  variant?: 'home' | 'list';
  /** Show the kind label in the list variant (archive and tag pages, where kinds are mixed). */
  showKind?: boolean;
  /** h3 under a section label (homepage), h2 under a page h1 (listings). */
  headingLevel?: 'h2' | 'h3';
}

const {
  title, date, summary, readingTime, href, type, author,
  draft = false, variant = 'home', showKind = false, headingLevel = 'h2',
} = Astro.props;

const Heading = headingLevel;
const kind = KIND_LABEL[type];
---

{variant === 'home' ? (
  <a class="post-row" href={href}>
    <div class="post-row__top">
      <span class="eyebrow">{kind}{draft && <> · <span class="draft-badge">Draft</span></>}</span>
      <span class="mono-meta">
        <time datetime={isoDate(date)}>{formatDate(date)}</time> · {shortReadingTime(readingTime)}
      </span>
    </div>
    <Heading class="post-row__title">{title}</Heading>
    {author && <p class="post-row__sub post-row__sub--author">{author}</p>}
    <p class="post-row__desc">{summary}</p>
  </a>
) : (
  <a class="post-row post-row--list" href={href}>
    <div class="post-row__main">
      <Heading class="post-row__title">{title}</Heading>
      {author && <p class="post-row__sub post-row__sub--author">{author}</p>}
      <p class="post-row__desc">{summary}</p>
    </div>
    <div class="post-row__side">
      {showKind && <span class="eyebrow">{kind}</span>}
      {draft && <span class="draft-badge">Draft</span>}
      <time class="mono-meta" datetime={isoDate(date)}>{formatDate(date, 'month')}</time>
      <span class="mono-meta">{shortReadingTime(readingTime)}</span>
    </div>
  </a>
)}
