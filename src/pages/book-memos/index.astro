---
import Page from '../../layouts/Page.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PostCard from '../../components/PostCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getBookMemos, toSummary, countLabel } from '../../lib/posts';

const posts = (await getBookMemos()).map((p) => toSummary(p, 'book-memo'));
const description = 'Not summaries — reactions. What stuck, what I\'d push back on, and how a book changed how I think.';
---

<Page title="Book Memos" description={description}>
  <div class="container">
    <SectionHeader eyebrow="Book Memos" title="Reading Notes" description={description} count={posts.length ? countLabel(posts.length, 'memo') : undefined} />
    {posts.length > 0 ? (
      <div class="post-list">
        {posts.map((post) => <PostCard {...post} variant="list" />)}
      </div>
    ) : (
      <EmptyState message="The first book memos are in progress." />
    )}
  </div>
</Page>
