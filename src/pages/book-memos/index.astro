---
import Page from '../../layouts/Page.astro';
import PostCard from '../../components/PostCard.astro';
import { getBookMemos, toSummary } from '../../lib/posts';

const posts = (await getBookMemos()).map((p) => toSummary(p, 'book-memo', `/book-memos/${p.slug}/`));
---

<Page
  title="Book Memos"
  description="Reading notes — not summaries but reactions: what stuck, what I'd push back on, and how it changed how I think."
>
  <div class="container">
    <header class="listing-header">
      <span class="eyebrow">Book Memos</span>
      <h1 class="listing-title">Reading notes</h1>
      <p class="listing-desc">
        Not summaries — reactions. What stuck, what I'd push back on,
        and how it changed how I think.
      </p>
    </header>

    {posts.length > 0 ? (
      <div class="post-list">
        {posts.map((post) => <PostCard {...post} />)}
      </div>
    ) : (
      <p class="empty-state">The first book memos are in progress. Check back soon.</p>
    )}
  </div>
</Page>
