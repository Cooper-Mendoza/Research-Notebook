---
import ProsePost from '../../layouts/ProsePost.astro';
import { getBookMemos, readingTime } from '../../lib/posts';

// Drafts are excluded here too, so a hidden memo is not reachable at its direct URL in production.
export async function getStaticPaths() {
  const posts = await getBookMemos();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<ProsePost
  title={post.data.title}
  date={post.data.date}
  summary={post.data.summary}
  readingTime={readingTime(post.body, post.data.readingTime)}
  author={post.data.author}
  tags={post.data.tags}
  draft={post.data.draft}
>
  <Content />
</ProsePost>
