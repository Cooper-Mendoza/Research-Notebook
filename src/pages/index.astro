---
import Page from '../layouts/Page.astro';
import PostCard from '../components/PostCard.astro';
import { getAllPosts, collectTags, tagHref, tagLabel } from '../lib/posts';

const posts = await getAllPosts();
const recent = posts.slice(0, 5);
const topics = collectTags(posts).slice(0, 8);

const description =
  'Finance student at UT Austin McCombs (Class of 2029) and officer of Texas Equity Management. Company research, equity analysis, and book memos.';
---

<Page title="Home" description={description}>
  <div class="container">

    <!-- Intro -->
    <section class="intro">
      <span class="eyebrow">Cooper Mendoza</span>
      <h1 class="intro__headline">
        Thinking in public,<br />slowly.
      </h1>
      <p class="intro__body">
        A public notebook — company research, book notes, and how my
        thinking changes over time. I'm a business student at UT Austin's
        McCombs School of Business, focused on equity valuation and investing.
        Based in Austin, Texas.
      </p>
    </section>

    <!-- Recent work -->
    <section class="section" aria-labelledby="recent-heading">
      <h2 class="section__heading" id="recent-heading">
        <span class="eyebrow">Recent work</span>
      </h2>
      {recent.length > 0 ? (
        <div class="post-list">
          {recent.map((post) => <PostCard {...post} headingLevel="h3" />)}
        </div>
      ) : (
        <p class="empty-state">
          First notes are in progress. Company research and book memos will
          appear here as they're published.
        </p>
      )}
    </section>

    <!-- Explore by topic — built from the tags on published posts, so it only shows real destinations -->
    {topics.length > 0 && (
      <section class="section" aria-labelledby="topics-heading">
        <h2 class="section__heading" id="topics-heading">
          <span class="eyebrow">Explore by topic</span>
        </h2>
        <ul class="topic-grid">
          {topics.map(({ tag, count }) => (
            <li>
              <a href={tagHref(tag)} class="topic-chip">
                {tagLabel(tag)} <span class="topic-chip__count">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

  </div>
</Page>

<style>
  .intro {
    padding: var(--space-16) 0 var(--space-12);
    max-width: 560px;
  }

  .intro .eyebrow {
    display: block;
    margin-bottom: var(--space-4);
  }

  .intro__headline {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: var(--size-headline);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-6);
  }

  .intro__body {
    font-family: var(--font-prose);
    font-size: var(--size-md);
    line-height: var(--leading-loose);
    color: var(--color-subtle);
    max-width: 48ch;
  }

  .section { margin-top: var(--space-16); }

  .section__heading {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .topic-grid {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .topic-chip {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text);
    text-decoration: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-2) var(--space-4);
    border-radius: 2px;
    transition: border-color 0.15s, color 0.15s;
  }

  .topic-chip__count { color: var(--color-subtle); margin-left: var(--space-1); }

  .topic-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-text);
  }
</style>
