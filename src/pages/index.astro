---
import Page from '../layouts/Page.astro';
import PostCard from '../components/PostCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { getAllPosts } from '../lib/posts';

const posts = await getAllPosts();
const recent = posts.slice(0, 5);
const n = (type: string) => posts.filter((p) => p.type === type).length;

const topics = [
  { href: '/research/',   title: 'Research',   count: n('research'),  desc: 'Company breakdowns, valuation work, and industry notes', tags: 'Companies · Valuation' },
  { href: '/book-memos/', title: 'Book Memos', count: n('book-memo'), desc: 'Notes and reactions from books worth reading deeply',     tags: 'Reading notes' },
  { href: '/projects/',   title: 'Projects',   count: n('project'),   desc: 'KPI frameworks, models, and analysis built for real problems', tags: 'Models · Dashboards' },
  { href: '/archive/',    title: 'Archive',    count: posts.length,   desc: 'Everything, in reverse chronological order',               tags: 'All writing' },
];

const description =
  'Finance student at UT Austin McCombs (Class of 2029) and officer of Texas Equity Management. Company research, equity analysis, book memos, and project work.';
---

<Page title="Home" description={description}>
  <div class="container">

    <section class="hero">
      <span class="eyebrow">Research &amp; Investing</span>
      <h1 class="hero__title">Cooper Mendoza</h1>
      <p class="hero__lede">
        This is my public notebook. I'm a finance student at UT Austin's
        McCombs School of Business and an officer of Texas Equity Management,
        our student-run investment fund, where I pitch stocks and present
        portfolio updates. I use this site to publish company research,
        valuation notes, book memos, and project work — including the KPI
        project I did for Dell.
      </p>
      <p class="hero__based">Based in Austin, Texas.</p>
      <div class="hero__actions">
        <a class="btn-solid" href="/about/">About me</a>
        <a class="link-muted" href="/archive/">
          All writing
          <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
      </div>
    </section>

    <hr class="rule" />

    <section class="section" aria-labelledby="recent-heading">
      <h2 class="eyebrow" id="recent-heading">Recent work</h2>
      {recent.length > 0 ? (
        <div class="post-list">
          {recent.map((post) => <PostCard {...post} headingLevel="h3" />)}
        </div>
      ) : (
        <EmptyState message="First notes are in progress. Company research, book memos, and project work will appear here as they're published." />
      )}
    </section>

    <hr class="rule" />

    <section class="section" aria-labelledby="topics-heading">
      <h2 class="eyebrow" id="topics-heading">Explore by topic</h2>
      <div class="topic-grid">
        {topics.map(({ href, title, count, desc, tags }) => (
          <a class="topic-cell" href={href}>
            <div class="topic-cell__head">
              <span class="topic-cell__title">{title}</span>
              {count > 0 && <span class="mono-meta">{count}</span>}
            </div>
            <p class="topic-cell__desc">{desc}</p>
            <span class="eyebrow">{tags}</span>
          </a>
        ))}
      </div>
    </section>

  </div>
</Page>

<style>
  .hero { padding: var(--space-16) 0 var(--space-12); }
  .hero .eyebrow { display: block; margin-bottom: 1.25rem; }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.75rem, 5vw + 1rem, 3.75rem);
    line-height: 1;
    letter-spacing: -0.025em;
    margin-bottom: var(--space-6);
  }

  .hero__lede {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.625;
    color: var(--ink-muted);
    max-width: 32rem;
    margin-bottom: var(--space-3);
  }

  .hero__based {
    font-family: var(--font-serif);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ink-muted);
    margin-bottom: var(--space-8);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .section + .rule, .hero + .rule { margin: 0; }
</style>
