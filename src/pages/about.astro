---
import Page from '../layouts/Page.astro';
import SectionHeader from '../components/SectionHeader.astro';

const interests = [
  'Equity valuation — what a business is actually worth, and why',
  'Building and defending a stock pitch',
  'Business models, unit economics, and where the moat is',
  'Capital allocation and management incentives',
  'KPI design and performance measurement',
];
---

<Page title="About" description="Cooper Mendoza — Finance student at UT Austin's McCombs School of Business (Class of 2029) and officer of Texas Equity Management.">
  <div class="container">
    <SectionHeader eyebrow="About" title="Cooper Mendoza" />

    <div class="prose about-body">
      <p>
        This is my public notebook. I'm a Finance student at the University of
        Texas at Austin, McCombs School of Business, Class of 2029. My focus is
        equity valuation, stock pitching, and investment analysis — the work of
        understanding what a business is actually worth and why.
      </p>
      <p>
        I'm an officer of <strong>Texas Equity Management (TEM)</strong>, a
        student-run investment fund at McCombs. We present stock pitches and
        portfolio updates to give our members real exposure to markets and the
        discipline of making a case in front of people who will push back on it.
      </p>
      <p>
        This site is where I publish company research, valuation notes, book
        memos, and project work. Everything here reflects my own research and
        views.
      </p>
    </div>

    <hr class="rule about-rule" />

    <section class="about-section" aria-labelledby="interests-heading">
      <h2 class="eyebrow" id="interests-heading">Interests</h2>
      <ul class="dot-list">
        {interests.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <hr class="rule about-rule" />

    <section class="about-section" id="contact" aria-labelledby="contact-heading">
      <h2 class="eyebrow" id="contact-heading">Get in touch</h2>
      <p class="about-contact">
        I'm reachable on LinkedIn for research, recruiting, and anything in the overlap.
      </p>
      <a class="link-caps" href="https://www.linkedin.com/in/cooper-mendoza" target="_blank" rel="noopener noreferrer">
        LinkedIn
        <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    </section>
  </div>
</Page>

<style>
  .about-body { padding-bottom: var(--space-10); }
  .about-rule { margin: 0; }
  .about-section { padding: var(--space-8) 0; }
  .about-section .eyebrow { display: block; margin-bottom: var(--space-4); }
  .about-contact {
    font-family: var(--font-serif);
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--ink-muted);
    max-width: 30rem;
    margin-bottom: var(--space-4);
  }
</style>
