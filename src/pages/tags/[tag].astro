---
import Page from '../../layouts/Page.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllPosts, collectTags, tagLabel, tagTitle, countLabel, type PostSummary } from '../../lib/posts';

// One page per tag that appears on a published post — nothing links to an empty topic.
export async function getStaticPaths() {
  const posts = await getAllPosts();
  return collectTags(posts).map(({ tag }) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.tags.includes(tag)) },
  }));
}

const tag = Astro.params.tag ?? '';
const { posts } = Astro.props as { posts: PostSummary[] };
const label = tagLabel(tag);
const heading = tagTitle(tag);
---

<Page title={`Topic: ${heading}`} description={`${countLabel(posts.length, 'piece')} tagged “${label}” — research, book memos, and projects by Cooper Mendoza.`}>
  <div class="container">
    <SectionHeader eyebrow="Topic" title={heading} count={countLabel(posts.length, 'piece')} />
    <div class="post-list">
      {posts.map((post) => <PostCard {...post} variant="list" showKind />)}
    </div>
  </div>
</Page>

