---
import Page from '../layouts/Page.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<Page title="Not found" description="That page doesn't exist." noindex>
  <div class="container">
    <SectionHeader eyebrow="404" title="Page Not Found" description="That page doesn't exist, or it moved. Try one of these instead." />
    <ul class="nf-links">
      <li><a class="link-caps" href="/">Home</a></li>
      <li><a class="link-caps" href="/research/">Research</a></li>
      <li><a class="link-caps" href="/book-memos/">Book Memos</a></li>
      <li><a class="link-caps" href="/projects/">Projects</a></li>
      <li><a class="link-caps" href="/about/">About</a></li>
    </ul>
  </div>
</Page>

<style>
  .nf-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
  }
</style>
