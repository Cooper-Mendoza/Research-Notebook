---
import Page from '../../layouts/Page.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import PostCard from '../../components/PostCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getResearch, toSummary, countLabel } from '../../lib/posts';

const posts = (await getResearch()).map((p) => toSummary(p, 'research'));
const description = 'Deep dives into how businesses work: how they make money, where the moat is, what the numbers say, and what the market may be missing.';
---

<Page title="Research" description={description}>
  <div class="container">
    <SectionHeader eyebrow="Research" title="Company & Industry Notes" description={description} count={posts.length ? countLabel(posts.length, 'note') : undefined} />
    {posts.length > 0 ? (
      <div class="post-list">
        {posts.map((post) => <PostCard {...post} variant="list" />)}
      </div>
    ) : (
      <EmptyState message="Research notes are being prepared for publication." />
    )}
  </div>
</Page>
