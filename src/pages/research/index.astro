---
import Page from '../../layouts/Page.astro';
import PostCard from '../../components/PostCard.astro';
import { getResearch, toSummary } from '../../lib/posts';

const posts = (await getResearch()).map((p) => toSummary(p, 'research', `/research/${p.slug}/`));
---

<Page
  title="Research"
  description="Deep dives into individual companies: how the business makes money, where the moat is, what the numbers say, and what the market may be missing."
>
  <div class="container">
    <header class="listing-header">
      <span class="eyebrow">Research</span>
      <h1 class="listing-title">Company &amp; industry notes</h1>
      <p class="listing-desc">
        Deep dives into individual companies — how the business makes money,
        where the moat is, what the numbers say, and what the market may be missing.
      </p>
    </header>

    {posts.length > 0 ? (
      <div class="post-list">
        {posts.map((post) => <PostCard {...post} />)}
      </div>
    ) : (
      <p class="empty-state">The first research notes are in progress. Check back soon.</p>
    )}
  </div>
</Page>
